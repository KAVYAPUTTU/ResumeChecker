FRONTEND
1.
You may have seen the older style:


<BrowserRouter>
  <Routes>
    <Route path="/" element={<Home />} />
    <Route path="/login" element={<Login />} />
  </Routes>
</BrowserRouter>


And the newer data-router style:

//Build the navigation system
const router = createBrowserRouter([
  { path: "/", element: <Home /> },
  { path: "/login", element: <Login /> }
]);

//Put that navigation system into the app
<RouterProvider router={router} />



